#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W        &kp E             &kp R           &kp T     &kp Y       &kp U            &kp I                &kp O             &kp P
&kp A         &kp S        &kp D             &lt 3 F         &kp G     &kp H       &lt 3 J          &kp K                &kp L             &kp MINUS
&mt LSHIFT Z  &mt LCTRL X  &mt LEFT_GUI C    &mt LEFT_ALT V  &kp B     &kp N       &mt RIGHT_ALT M  &mt RIGHT_GUI COMMA  &mt RCTRL PERIOD  &mt RSHFT SLASH
&kp LGUI      &kp LALT     &kp INT_MUHENKAN  &lt 1 ENTER     &kp BSPC  &kp DELETE  &lt 2 SPACE      &kp INT_HENKAN       &kp RIGHT_GUI     &kp RIGHT_ALT
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp F1     &kp F2   &kp F3   &kp F4   &trans       &none   &kp N7  &kp N8  &kp N9        &none
&kp F5     &kp F6   &kp F7   &kp F8   &kt TAB      &none   &kp N4  &kp N5  &kp NUMBER_6  &none
&kp F9     &kp F10  &kp F11  &kp F12  &kp LS(TAB)  &kp N0  &kp N1  &kp N2  &kp N3        &none
&kp GRAVE  &trans   &trans   &trans   &trans       &trans  &trans  &trans  &trans        &kp RS(CAPSLOCK)
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&kp QMARK      &kp LS(N2)      &kp EXCL          &kp LS(SQT)  &kp LS(SEMI)  &kp EQUAL         &kp UNDERSCORE  &kp EQUAL       &kp RS(N8)    &kp RS(N9)
&kp LS(N6)     &kp LS(N7)      &kp LS(N4)        &none        &kp SLASH     &kp RS(N3)        &kp BACKSLASH   &kp RS(N5)      &kp RBKT      &kp NUHS
&kp LS(COMMA)  &kp LS(PERIOD)  &kp SINGLE_QUOTE  &kp SEMI     &none         &kp SINGLE_QUOTE  &kp LS(EQUAL)   &kp LEFT_BRACE  &kp RS(RBKT)  &kp RS(NUHS)
&trans         &trans          &trans            &trans       &trans        &trans            &trans          &trans          &trans        &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&kp HOME  &kp UP            &kp PG_UP       &trans     &trans        &none      &none      &none      &none      &none
&kp LEFT  &kp DOWN          &kp RIGHT       &trans     &trans        &kp RCTRL  &mkp LCLK  &mkp MCLK  &mkp RCLK  &none
&kp END   &kp LEFT_CONTROL  &kp PAGE_DOWN   &trans     &trans        &none      &mkp MB4   &mkp MB5   &kp RCTRL  &none
&none     &trans            &kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &trans     &trans     &trans     &trans     &to 0
            >;
        };
    };
};
